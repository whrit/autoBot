# Alpaca
ALPACA_API_KEY=your_key
ALPACA_API_SECRET=your_secret
# Set to "paper" or "live"
ALPACA_ENV=paper

# Postgres
PGHOST=localhost
PGPORT=5432
PGDATABASE=qt_registry
PGUSER=qt
PGPASSWORD=qt

# S3-compatible lake (MinIO)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=lake

# Registry API
REGISTRY_BIND=0.0.0.0
REGISTRY_PORT=8080
